{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zuudevs/ze_json_research/blob/main/research/schemas/experiment.schema.json",
  "title": "ze_json_research experiment definition",
  "type": "object",
  "required": ["schema_version", "experiment"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "experiment": {
      "type": "object",
      "required": [
        "id", "title", "status", "categories", "purpose",
        "research_question", "hypotheses", "research_basis", "references",
        "metrics", "protocol", "variants", "workloads",
        "measurement_contracts", "execution"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:-]*$" },
        "title": { "type": "string", "minLength": 3 },
        "status": { "enum": ["draft", "reviewed", "approved_for_run", "retired"] },
        "categories": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "purpose": { "type": "string", "minLength": 10 },
        "motivation": { "type": "string" },
        "research_question": { "type": "string", "minLength": 10 },
        "hypotheses": { "type": "array", "items": { "type": "object" } },
        "research_basis": { "type": "array", "items": { "type": "object" } },
        "references": { "type": "array", "items": { "type": "object" } },
        "assumptions": { "type": "array", "items": { "type": "string" } },
        "limitations": { "type": "array", "items": { "type": "string" } },
        "metrics": { "type": "object" },
        "protocol": { "type": "object" },
        "comparison": { "type": "object" },
        "variants": { "type": "array", "minItems": 1, "items": { "type": "object" } },
        "workloads": { "type": "array", "minItems": 1, "items": { "type": "object" } },
        "measurement_contracts": { "type": "array", "minItems": 1, "items": { "type": "object" } },
        "execution": { "type": "object" }
      },
      "additionalProperties": true
    }
  }
}
